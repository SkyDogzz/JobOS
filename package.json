{
  "name": "jobos",
  "version": "1.2.1",
  "private": true,
  "description": "An end-to-end operating system for job searching.",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:local": "node scripts/dev-local.mjs",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "XDG_DATA_HOME=.xdg/data XDG_CACHE_HOME=.xdg/cache pnpm --filter @jobos/database db:generate",
    "db:migrate": "XDG_DATA_HOME=.xdg/data XDG_CACHE_HOME=.xdg/cache pnpm --filter @jobos/database db:migrate",
    "seed:demo": "node scripts/seed-demo.mjs",
    "reset:demo": "node scripts/reset-demo.mjs",
    "test:api": "node scripts/test-api-integration.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "test:e2e": "playwright test",
    "test:e2e:reset": "node scripts/e2e-reset.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@playwright/test": "^1.51.1",
    "postgres": "^3.4.4",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
