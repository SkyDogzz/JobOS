{
  "name": "jobos",
  "version": "0.1.0",
  "private": true,
  "description": "An end-to-end operating system for job searching.",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @jobos/database db:generate",
    "db:migrate": "pnpm --filter @jobos/database db:migrate"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}

