{
  "name": "@jobos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && nest build",
    "dev": "pnpm --dir ../.. turbo build --filter=@jobos/api^... && pnpm build && pnpm start",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/apps/api/src/main.js",
    "test": "pnpm --dir ../.. test:api",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^11.1.1",
    "@fastify/static": "^6.12.0",
    "@jobos/config": "workspace:*",
    "@jobos/database": "workspace:*",
    "@jobos/document-parser": "workspace:*",
    "@jobos/job-sources": "workspace:*",
    "@jobos/ai": "workspace:*",
    "@jobos/validation": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@fastify/cookie": "^9.4.0",
    "drizzle-orm": "^0.34.1",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3"
  }
}
